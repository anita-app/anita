{
  "$comment": "Feature catalogue check (scripts/check-features.ts, rules in AGENTS.md). Surfaces: what must be listed by some feature, read from the sources. Docs targets with enforce:false only report.",
  "sources": "src",
  "exclude": ["^src/types/", "^src/app/version\\.ts$"],
  "catalogue": "features/catalogue.json",
  "catalogueMarkdown": "features/catalogue.md",
  "groups": "features/groups.json",
  "kinds": ["project", "section", "record", "field", "view", "relation", "storage", "sync", "import", "export", "template", "security", "navigation", "app"],
  "statuses": ["stable", "beta", "experimental", "deprecated"],
  "surfaces": [
    { "name": "screen", "tag": "routes", "from": { "type": "object-keys", "file": "src/app/libs/routing/anita-routes.constant.ts", "name": "ANITA_URLS" } },
    { "name": "keyboard shortcut", "tag": "shortcuts", "from": { "type": "shortcuts", "hook": "useShortcut" } },
    { "name": "WordPress error", "tag": "errors", "prefix": "wordpress.", "from": { "type": "enum", "file": "src/app/libs/cloud-sync/wordpress/wordpress-api-error.class.ts", "name": "WordPressErrorCode" } },
    { "name": "Dropbox error", "tag": "errors", "prefix": "dropbox.", "from": { "type": "enum", "file": "src/app/libs/cloud-sync/dropbox/dropbox-error.class.ts", "name": "DropboxErrorCode" } },
    { "name": "field type", "tag": "covers", "prefix": "field:", "from": { "type": "enum-refs", "file": "src/app/components/shared-components/forms-automator/form-component-codes.enum.ts", "name": "SELECTABLE_FORM_ELES", "enum": "FORM_COMPONENTS_CODES" } },
    { "name": "text input type", "tag": "covers", "prefix": "input-type:", "from": { "type": "enum", "file": "src/app/components/shared-components/forms-automator/input-supported-types.const.ts", "name": "TextInputSupportedTypes" } },
    { "name": "date input type", "tag": "covers", "prefix": "input-type:", "from": { "type": "enum", "file": "src/app/components/shared-components/forms-automator/input-supported-types.const.ts", "name": "DateInputSupportedTypes" } },
    { "name": "date & time input type", "tag": "covers", "prefix": "input-type:", "from": { "type": "enum", "file": "src/app/components/shared-components/forms-automator/input-supported-types.const.ts", "name": "DateTimeInputSupportedTypes" } },
    { "name": "validator", "tag": "covers", "prefix": "validator:", "from": { "type": "enum", "file": "src/app/components/shared-components/forms-automator/form-validation/supported-validators.enum.ts", "name": "SUPPORTED_VALIDATORS" } },
    { "name": "list view", "tag": "covers", "prefix": "view:", "from": { "type": "enum", "file": "src/app/models/section/view-settings.const.ts", "name": "SupportedViews" } },
    { "name": "cloud service", "tag": "covers", "prefix": "cloud:", "from": { "type": "enum", "file": "src/app/libs/cloud-sync/cloud-sync-base.class.ts", "name": "SupportedCloud" } },
    { "name": "export scope", "tag": "covers", "prefix": "export-scope:", "from": { "type": "enum", "file": "src/app/models/project/project-exporter.class.ts", "name": "ExportScope" } }
  ],
  "docs": [
    { "path": "../landing/src/app/docs", "enforce": false }
  ]
}
