{
  "name": "anita-manager",
  "version": "1.0.0",
  "appVersion": "1.0.0",
  "landingVersion": "0.21.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "eslint": "yarn workspace anita-app eslint",
    "licenses-landing": "cd landing && npm run licenses",
    "licenses-app": "yarn workspace anita-app licenses",
    "licenses": "yarn licenses-landing && yarn licenses-app",
    "build-landing": "cd landing && npm run build",
    "build-app": "yarn workspace anita-app build",
    "features": "yarn workspace anita-app features",
    "testdist": "cd anita-app.github.io && npx http-server",
    "buildTest": "yarn build-app && yarn testdist",
    "pull-main": "cd anita-app.github.io && git pull --force origin main",
    "propagate-version": "node version-propagator.js",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "fs-extra": "^10.0.0"
  },
  "author": "ilDon",
  "license": "CC-BY-NC-4.0"
}
